self:
{ config, lib, pkgs, ... }:

let
  cfg = config.services.pw-airplay;
  pw-airplayd = self.packages.${pkgs.system}.pw-airplayd;
  owntone-airplay = self.packages.${pkgs.system}.owntone-airplay;

  boolStr = b: if b then "true" else "false";

  groupsText = lib.concatStrings (lib.mapAttrsToList (name: members: ''

    [group "${name}"]
    members = ${lib.concatStringsSep ", " members}
  '') cfg.groups);

  settingsText = ''
    # Generated by Home Manager (services.pw-airplay). Edit home.nix, not
    # this file: it is overwritten on activation, see the NixOS adaptation
    # notes in README.md.
    idle_timeout = ${toString cfg.settings.idleTimeout}
    pause_timeout = ${toString cfg.settings.pauseTimeout}
    start_buffer_ms = ${toString cfg.settings.startBufferMs}
    pipe_start_buffer_ms = ${toString cfg.settings.pipeStartBufferMs}
    latency_offset_ms = ${toString cfg.settings.latencyOffsetMs}
  '' + lib.optionalString (cfg.settings.senderName != null) ''
    sender_name = ${cfg.settings.senderName}
  '' + ''
    now_playing = ${boolStr cfg.settings.nowPlaying}
    all_speakers_sink = ${boolStr cfg.settings.allSpeakersSink}
    all_speakers_name = ${cfg.settings.allSpeakersName}
  '' + lib.optionalString (cfg.settings.hide != [ ]) ''
    hide = ${lib.concatStringsSep ", " cfg.settings.hide}
  '' + lib.optionalString (cfg.settings.engineLogLevel != null) ''
    engine_log_level = ${cfg.settings.engineLogLevel}
  '' + groupsText;
in {
  options.services.pw-airplay = {
    enable = lib.mkEnableOption ''
      pw-airplay, AirPlay 2 output for PipeWire. Needs pw-airplay's NixOS
      module (airptpd + firewall ports) enabled once system-wide for
      multi-room sync to work
    '';

    disablePipewireRaop = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Disable PipeWire's own AirPlay 1 sinks (module-raop-discover),
        which would otherwise show the same speakers a second time, with
        the wrong latency.
      '';
    };

    settings = {
      idleTimeout = lib.mkOption {
        type = lib.types.ints.unsigned;
        default = 30;
        description = ''
          Seconds of silence after which the speakers are released, so
          other devices can use them. Audio resuming within this delay
          starts without reconnecting.
        '';
      };

      pauseTimeout = lib.mkOption {
        type = lib.types.ints.unsigned;
        default = 300;
        description = ''
          Same as idleTimeout, while the application reports it is paused.
        '';
      };

      startBufferMs = lib.mkOption {
        type = lib.types.ints.unsigned;
        default = 2250;
        description = ''
          How far ahead audio is scheduled on the speakers, in
          milliseconds. 2250 is what Apple senders use.
        '';
      };

      pipeStartBufferMs = lib.mkOption {
        type = lib.types.ints.unsigned;
        default = 100;
        description = "Audio held in the engine's input buffer, absorbs scheduling jitter.";
      };

      latencyOffsetMs = lib.mkOption {
        type = lib.types.int;
        default = 0;
        description = ''
          Added to the latency reported to applications. Positive if sound
          comes after the picture, negative if it comes before.
        '';
      };

      senderName = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = ''
          Name of this computer on the speakers. Defaults to the pretty
          hostname, else the hostname, when left null.
        '';
      };

      nowPlaying = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Send what is playing to the speakers, and take
          play/pause/next/previous from them. Needs a media player with
          MPRIS support.
        '';
      };

      allSpeakersSink = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "An output playing to all speakers at once (computers are left out).";
      };

      allSpeakersName = lib.mkOption {
        type = lib.types.str;
        default = "All speakers";
      };

      hide = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Speakers to ignore.";
      };

      engineLogLevel = lib.mkOption {
        type = lib.types.nullOr (lib.types.enum [ "log" "info" "debug" ]);
        default = null;
        description = "Log level of the AirPlay engine.";
      };
    };

    groups = lib.mkOption {
      type = lib.types.attrsOf (lib.types.listOf lib.types.str);
      default = { };
      example = { Downstairs = [ "Living room" "Kitchen" ]; };
      description = ''
        Groups of speakers, each becomes an output of its own, played in
        sync. Members are the names shown in the sound settings; a stereo
        pair counts as one speaker.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ pw-airplayd owntone-airplay ];

    xdg.configFile."pw-airplay/pw-airplay.conf".text = settingsText;

    xdg.configFile."pipewire/pipewire.conf.d/50-pw-airplay-no-raop.conf" =
      lib.mkIf cfg.disablePipewireRaop {
        text = ''
          context.properties = {
              module.raop = false
          }
        '';
      };

    systemd.user.services.pw-airplay-engine = {
      Unit = {
        Description = "AirPlay 2 engine for pw-airplay (OwnTone)";
        After = [ "network-online.target" "avahi-daemon.service" ];
        PartOf = [ "pw-airplay.service" ];
      };
      Service = {
        Type = "simple";
        ExecStartPre = "${pw-airplayd}/bin/pw-airplayd --write-engine-conf %h/.local/share/pw-airplay/owntone.conf";
        ExecStart = "${owntone-airplay}/sbin/owntone -f -c %h/.local/share/pw-airplay/owntone.conf";
        Restart = "on-failure";
        RestartSec = 2;
      };
      Install.WantedBy = [ "default.target" ];
    };

    systemd.user.services.pw-airplay = {
      Unit = {
        Description = "AirPlay 2 output for PipeWire";
        Requires = [ "pw-airplay-engine.service" ];
        After = [ "pipewire.service" "pipewire-pulse.service" "wireplumber.service" "pw-airplay-engine.service" ];
        Wants = [ "pipewire.service" ];
      };
      Service = {
        Type = "simple";
        Environment = "PIPEWIRE_DEBUG=2,default:3";
        ExecStart = "${pw-airplayd}/bin/pw-airplayd";
        Restart = "on-failure";
        RestartSec = 2;
      };
      Install.WantedBy = [ "default.target" ];
    };
  };
}
