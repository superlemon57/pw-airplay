+/* Minimal protobuf writer, enough for the few messages we send */
+
+static void
+pb_varint(struct evbuffer *b, uint64_t v)
+{
+  uint8_t buf[10];
+  int n = 0;
+
+  do
+    {
+      buf[n] = v & 0x7f;
+      v >>= 7;
+      if (v)
+	buf[n] |= 0x80;
+      n++;
+    }
+  while (v);
+  evbuffer_add(b, buf, n);
+}
+
+static void
+pb_uint(struct evbuffer *b, uint32_t field, uint64_t v)
+{
+  pb_varint(b, (uint64_t)field << 3);
+  pb_varint(b, v);
+}
+
+static void
+pb_bytes(struct evbuffer *b, uint32_t field, const void *data, size_t len)
+{
+  pb_varint(b, ((uint64_t)field << 3) | 2);
+  pb_varint(b, len);
+  evbuffer_add(b, data, len);
+}
+
+static void
+pb_string(struct evbuffer *b, uint32_t field, const char *s)
+{
+  pb_bytes(b, field, s, strlen(s));
+}
+
+static void
+pb_message(struct evbuffer *b, uint32_t field, struct evbuffer *sub)
+{
+  pb_bytes(b, field, evbuffer_pullup(sub, -1), evbuffer_get_length(sub));
+}
+
+static void
+mrp_device_uuid(char *out, size_t size)
+{
+  // Stable across restarts, derived from our identity
+  snprintf(out, size, "%08X-%04X-4%03X-8%03X-%012" PRIX64,
+	   (uint32_t)(libhash >> 32), (uint32_t)(libhash >> 16) & 0xffff, (uint32_t)libhash & 0xfff,
+	   (uint32_t)(airplay_device_id >> 48) & 0xfff, (uint64_t)(airplay_device_id & 0xffffffffffffULL));
+}
+
+static int
+mrp_plist_add(struct evrtsp_request *req, plist_t root)
+{
+  uint8_t *data;
+  size_t len;
+  int ret;
+
+  ret = wplist_to_bin(&data, &len, root);
+  plist_free(root);
+  if (ret < 0)
+    return -1;
+
+  evbuffer_add(req->output_buffer, data, len);
+  free(data);
+  return 0;
+}
+
+// { type: <type>, params: <params> }
+static int
+mrp_command_add(struct evrtsp_request *req, const char *type, plist_t params)
+{
+  plist_t root = plist_new_dict();
+
+  DPRINTF(E_INFO, L_AIRPLAY, "MediaRemote: sending %s\n", type ? type : "device info");
+
+  if (type)
+    wplist_dict_add_string(root, "type", type);
+  plist_dict_set_item(root, "params", params);
+  return mrp_plist_add(req, root);
+}
+
+static int
+payload_make_mrp_device_info(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  struct evbuffer *inner;
+  struct evbuffer *msg;
+  struct evbuffer *blob;
+  plist_t params;
+  char uuid[40];
+  char buf[24];
+  int ret;
+
+  CHECK_NULL(L_AIRPLAY, inner = evbuffer_new());
+  CHECK_NULL(L_AIRPLAY, msg = evbuffer_new());
+  CHECK_NULL(L_AIRPLAY, blob = evbuffer_new());
+
+  mrp_device_uuid(uuid, sizeof(uuid));
+  snprintf(buf, sizeof(buf), "%016" PRIX64, libhash);
+
+  // DeviceInfoMessage, the identity of a real iPhone sender
+  pb_string(inner, 1, uuid);                    // uniqueIdentifier
+  pb_string(inner, 2, airplay_client_name);     // name
+  pb_string(inner, 3, "iPhone");                // localizedModelName
+  pb_string(inner, 4, "21F90");                 // systemBuildVersion
+  pb_string(inner, 5, mediaremote_bundle_id()); // applicationBundleIdentifier
+  pb_uint(inner, 7, 1);                         // protocolVersion
+  pb_uint(inner, 8, MRP_LAST_SUPPORTED_MSG);    // lastSupportedMessageType
+  pb_uint(inner, 9, 1);                         // supportsSystemPairing
+  pb_uint(inner, 10, 1);                        // allowsPairing
+  pb_string(inner, 12, mediaremote_bundle_id());// systemMediaApplication
+  pb_uint(inner, 13, 1);                        // supportsACL
+  pb_uint(inner, 14, 1);                        // supportsSharedQueue
+  pb_uint(inner, 15, 1);                        // supportsExtendedMotion
+  pb_uint(inner, 17, 2);                        // sharedQueueVersion
+  pb_string(inner, 19, buf);                    // deviceUID (our DACP-ID)
+  pb_uint(inner, 21, MRP_DEVICE_CLASS_IPHONE);  // deviceClass
+  pb_uint(inner, 22, 1);                        // logicalDeviceCount
+  pb_string(inner, 31, "com.apple.podcasts");   // systemPodcastApplication
+  pb_string(inner, 39, "iPhone17,1");           // modelID
+  pb_string(inner, 41, session->session_uuid);  // routingContextID
+  pb_string(inner, 42, session->group_uuid);    // airPlayGroupID
+  pb_string(inner, 43, "com.apple.iBooks");     // systemBooksApplication
+
+  // ProtocolMessage envelope: type first, then the extension, then an id
+  uuid_make(uuid);
+  pb_uint(msg, 1, MRP_MSG_DEVICE_INFO);
+  pb_message(msg, MRP_EXT_DEVICE_INFO, inner);
+  pb_string(msg, 85, uuid);
+
+  // { params: { data: <varint length + protobuf> } }
+  pb_varint(blob, evbuffer_get_length(msg));
+  evbuffer_add_buffer(blob, msg);
+
+  params = plist_new_dict();
+  wplist_dict_add_data(params, "data", evbuffer_pullup(blob, -1), evbuffer_get_length(blob));
+  ret = mrp_command_add(req, NULL, params);
+
+  evbuffer_free(inner);
+  evbuffer_free(msg);
+  evbuffer_free(blob);
+  return ret;
+}
+
+static int
+payload_make_mrp_now_playing(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  struct airplay_metadata *rmd = airplay_cur_metadata ? airplay_cur_metadata->priv : NULL;
+  struct timespec now;
+  double elapsed;
+  plist_t info;
+  plist_t params;
+  char artwork_id[24];
+
+  info = plist_new_dict();
+
+  // An empty dict clears what the receiver shows
+  if (rmd)
+    {
+      clock_gettime(CLOCK_REALTIME, &now);
+      // The timestamp only has whole seconds, so the elapsed time is given as
+      // of that second
+      elapsed = mrp_clock_elapsed(&now) - (mrp_clock.playing ? now.tv_nsec / 1e9 : 0);
+
+      wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoTitle", rmd->title ? rmd->title : "");
+      wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoArtist", rmd->artist ? rmd->artist : "");
+      wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoAlbum", rmd->album ? rmd->album : "");
+      if (rmd->len_ms > 0)
+	plist_dict_set_item(info, "kMRMediaRemoteNowPlayingInfoDuration", plist_new_real(rmd->len_ms / 1000.0));
+      plist_dict_set_item(info, "kMRMediaRemoteNowPlayingInfoElapsedTime", plist_new_real(elapsed > 0 ? elapsed : 0));
+      plist_dict_set_item(info, "kMRMediaRemoteNowPlayingInfoPlaybackRate", plist_new_real(mrp_clock.playing ? 1.0 : 0.0));
+      plist_dict_set_item(info, "kMRMediaRemoteNowPlayingInfoDefaultPlaybackRate", plist_new_real(1.0));
+      plist_dict_set_item(info, "kMRMediaRemoteNowPlayingInfoTimestamp", plist_new_unix_date(now.tv_sec));
+      wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoMediaType", "MRMediaRemoteMediaTypeMusic");
+      wplist_dict_add_uint(info, "kMRMediaRemoteNowPlayingInfoUniqueIdentifier", rmd->uid);
+
+      // The info is replaced as a whole on every push, so artwork must
+      // always be included or it disappears
+      if (rmd->artwork && rmd->artwork_fmt == ART_FMT_JPEG && evbuffer_get_length(rmd->artwork) > 0)
+	{
+	  snprintf(artwork_id, sizeof(artwork_id), "%016" PRIx64, rmd->uid);
+	  wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoArtworkIdentifier", artwork_id);
+	  wplist_dict_add_string(info, "kMRMediaRemoteNowPlayingInfoArtworkMIMEType", "image/jpeg");
+	  wplist_dict_add_data(info, "kMRMediaRemoteNowPlayingInfoArtworkData",
+	    evbuffer_pullup(rmd->artwork, -1), evbuffer_get_length(rmd->artwork));
+	}
+    }
+
+  params = plist_new_dict();
+  wplist_dict_add_string(params, "type", "npi-text");
+  wplist_dict_add_string(params, "mergePolicy", "replace");
+  plist_dict_set_item(params, "params", info);
+
+  return mrp_command_add(req, "updateMRNowPlayingInfo", params);
+}
+
+// Each entry is itself a serialized plist
+static void
+mrp_command_info_add(plist_t array, int command, bool enabled, plist_t options)
+{
+  plist_t dict = plist_new_dict();
+  uint8_t *data;
+  size_t len;
+
+  wplist_dict_add_int(dict, "kCommandInfoCommandKey", command);
+  wplist_dict_add_bool(dict, "kCommandInfoEnabledKey", enabled);
+  if (options)
+    plist_dict_set_item(dict, "kCommandInfoOptionsKey", options);
+
+  if (wplist_to_bin(&data, &len, dict) == 0)
+    {
+      plist_array_append_item(array, plist_new_data((const char *)data, len));
+      free(data);
+    }
+  plist_free(dict);
+}
+
+static int
+payload_make_mrp_supported_commands(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  // MRMediaRemoteCommand numbering, order as an iPhone sends it. We take
+  // play (0), pause (1), toggle (2), stop (3), next (4), previous (5), and
+  // leave seeking and skip intervals disabled.
+  static const int simple[] = { 10, 11, 8, 9, 5, 4, 3, 2, 1, 0 };
+  plist_t commands = plist_new_array();
+  plist_t params;
+  plist_t opt;
+
+  opt = plist_new_dict();
+  wplist_dict_add_int(opt, "kMRMediaRemoteCommandInfoShuffleMode", 1);
+  mrp_command_info_add(commands, 26, false, opt);
+
+  opt = plist_new_dict();
+  wplist_dict_add_int(opt, "kMRMediaRemoteCommandInfoRepeatMode", 1);
+  mrp_command_info_add(commands, 25, false, opt);
+
+  opt = plist_new_dict();
+  wplist_dict_add_bool(opt, "kMRMediaRemoteCommandInfoCanBeControlledByScrubbingKey", false);
+  wplist_dict_add_bool(opt, "kMRMediaRemoteCommandInfoSupportsReferencePosition", false);
+  mrp_command_info_add(commands, 24, false, opt);
+
+  for (size_t i = 0; i < ARRAY_SIZE(simple); i++)
+    mrp_command_info_add(commands, simple[i], simple[i] <= 5, NULL);
+
+  params = plist_new_dict();
+  plist_dict_set_item(params, "mrSupportedCommandsFromSender", commands);
+  return mrp_command_add(req, "updateMRSupportedCommands", params);
+}
+
+static int
+payload_make_mrp_playback_state(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  plist_t params = plist_new_dict();
+
+  wplist_dict_add_uint(params, "mrPlaybackState", mrp_clock.playing ? MRP_STATE_PLAYING : MRP_STATE_PAUSED);
+  return mrp_command_add(req, "updateMRPlaybackState", params);
+}
+
+static int
+payload_make_mrp_now_playing_client(struct evrtsp_request *req, struct airplay_session *session, void *arg)
+{
+  struct evbuffer *client;
+  plist_t params;
+  int ret;
+
+  CHECK_NULL(L_AIRPLAY, client = evbuffer_new());
+
+  // NowPlayingClient protobuf, without envelope
+  pb_uint(client, 1, getpid());                  // processIdentifier
+  pb_string(client, 2, mediaremote_bundle_id()); // bundleIdentifier
+  pb_string(client, 7, airplay_client_name);     // displayName
+
+  params = plist_new_dict();
+  wplist_dict_add_data(params, "mrNowPlayingClient", evbuffer_pullup(client, -1), evbuffer_get_length(client));
+  ret = mrp_command_add(req, "updateMRNowPlayingClient", params);
+
+  evbuffer_free(client);
+  return ret;
+}
+
+static enum airplay_seq_type
+response_handler_mrp(struct evrtsp_request *req, struct airplay_session *session)
+{
+  if (req->response_code != RTSP_OK)
+    {
+      // Don't let now playing break audio, just stop trying
+      DPRINTF(E_LOG, L_AIRPLAY, "'%s' rejected MediaRemote now playing (%d %s), disabling it for this session\n",
+	session->devname, req->response_code, req->response_code_line);
+      session->wants_mediaremote = false;
+      return AIRPLAY_SEQ_ABORT;
+    }
+
+  DPRINTF(E_INFO, L_AIRPLAY, "MediaRemote: '%s' accepted (%d)\n", session->devname, req->response_code);
+  return AIRPLAY_SEQ_CONTINUE;
+}
+
+static void
+mediaremote_failure(struct airplay_session *session)
+{
+  DPRINTF(E_WARN, L_AIRPLAY, "MediaRemote request to '%s' failed\n", session->devname);
+}
+
+static void
+mediaremote_send(struct airplay_session *session, enum airplay_seq_type seq_type, const char *log_caller)
+{
+  if (session->wants_mediaremote)
+    sequence_start(seq_type, session, NULL, log_caller);
+}
