 /* ----------------------------- Metadata handling -------------------------- */
 
+/* ---------------------------- MediaRemote --------------------------------
+ *
+ * Apple receivers (HomePod, Apple TV) only show what is playing, both on
+ * themselves and on an iPhone looking at them, and only offer remote control,
+ * for senders that register as a MediaRemote now playing source. The DMAP
+ * SET_PARAMETER metadata above is accepted but not displayed by them.
+ *
+ * A sender does this with POST /command requests on the encrypted RTSP
+ * connection, carrying binary plists. Shapes follow what a real iPhone sends,
+ * as captured and documented by the cliairplay project (Music Assistant,
+ * DESIGN.md section 8), with protobuf field numbers from pyatv. Receivers send
+ * commands back on the event channel, see airplay_events.c.
+ */
+
+#define MRP_MSG_DEVICE_INFO       15
+#define MRP_EXT_DEVICE_INFO       20
+#define MRP_DEVICE_CLASS_IPHONE   1
+#define MRP_LAST_SUPPORTED_MSG    139
+
+enum mrp_playback_state
+{
+  MRP_STATE_PLAYING = 1,
+  MRP_STATE_PAUSED  = 2,
+  MRP_STATE_STOPPED = 3,
+};
+
+// The receiver extrapolates elapsed time from the last value we sent, so we
+// keep a clock that is anchored on each update and frozen while paused
+static struct
+{
+  bool playing;
+  uint32_t base_ms;
+  struct timespec anchor; // CLOCK_REALTIME
+} mrp_clock;
+
+static void
+mrp_clock_set(uint32_t pos_ms, bool playing)
+{
+  mrp_clock.base_ms = pos_ms;
+  mrp_clock.playing = playing;
+  clock_gettime(CLOCK_REALTIME, &mrp_clock.anchor);
+}
+
+static double
+mrp_clock_elapsed(const struct timespec *now)
+{
+  double elapsed = mrp_clock.base_ms / 1000.0;
+
+  if (mrp_clock.playing)
+    elapsed += (now->tv_sec - mrp_clock.anchor.tv_sec) + (now->tv_nsec - mrp_clock.anchor.tv_nsec) / 1e9;
+  return elapsed > 0 ? elapsed : 0;
+}
+
+static void
+mrp_clock_pause(void)
+{
+  struct timespec now;
+
+  if (!mrp_clock.playing)
+    return;
+  clock_gettime(CLOCK_REALTIME, &now);
+  mrp_clock_set((uint32_t)(mrp_clock_elapsed(&now) * 1000), false);
+}
+
+static void
+mrp_clock_resume(void)
+{
+  if (mrp_clock.playing)
+    return;
+  mrp_clock_set(mrp_clock.base_ms, true);
+}
+
+// Stable per track, the receiver treats a new value as a new item
+static uint64_t
+mediaremote_uid(struct db_queue_item *queue_item)
+{
+  const char *parts[] = { queue_item->title, queue_item->artist, queue_item->album };
+  uint64_t hash = 14695981039346656037ULL; // FNV-1a
+  const char *p;
+
+  for (size_t i = 0; i < ARRAY_SIZE(parts); i++)
+    for (p = parts[i] ? parts[i] : ""; ; p++)
+      {
+	hash = (hash ^ (uint8_t)*p) * 1099511628211ULL;
+	if (!*p)
+	  break;
+      }
+  return hash & 0x7fffffffffffffffULL;
+}
+
