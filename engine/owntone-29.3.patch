+// For live pipe sources: discards buffered data beyond pipe_start_buffer_ms,
+// so that the delay accumulated while outputs were starting up doesn't end up
+// as permanent extra latency. Must be called before the player starts reading.
+void
+input_live_trim(void)
+{
+  struct marker *marker;
+  size_t len;
+  size_t n;
+
+  pthread_mutex_lock(&input_buffer.mutex);
+
+  len = evbuffer_get_length(input_buffer.evbuf);
+  if (!pipe_start_buffer_bytes || input_now_reading.type != INPUT_TYPE_PIPE || len <= pipe_start_buffer_bytes)
+    goto out;
+
+  n = len - pipe_start_buffer_bytes;
+  n -= n % 4; // Keep frame alignment (pipe input is always 16 bit stereo)
+
+  evbuffer_drain(input_buffer.evbuf, n);
+  input_buffer.bytes_read += n;
+
+  // Markers in the discarded range (e.g. the initial quality marker) must still
+  // reach the player, so move them up to the new read position
+  for (marker = input_buffer.marker_tail; marker && marker->pos < input_buffer.bytes_read; marker = marker->prev)
+    marker->pos = input_buffer.bytes_read;
+
+  DPRINTF(E_INFO, L_PLAYER, "Live pipe: trimmed %zu bytes of start-up backlog\n", n);
+
+ out:
+  pthread_mutex_unlock(&input_buffer.mutex);
+}
+
+// While a live pipe source plays, remote commands from speakers (play/pause,
+// next, previous) are meant for whatever feeds the pipe, not for our own
+// player: "next" would end the pipe item. If pipe_remote_fifo is configured,
+// they are written there as lines ("play", "pause", "playpause", "next",
+// "prev", "stop") for the feeding application. Returns true if forwarded, so
+// the caller must not act on the command itself. Any thread.
+bool
+input_live_remote_forward(const char *command)
+{
+  const char *path = cfg_getstr(cfg_getsec(cfg, "library"), "pipe_remote_fifo");
+  char line[32];
+  bool live;
+  int len;
+  int fd;
+
+  if (!path)
+    return false;
+
+  pthread_mutex_lock(&input_buffer.mutex);
+  live = (input_now_reading.type == INPUT_TYPE_PIPE && input_now_reading.open);
+  pthread_mutex_unlock(&input_buffer.mutex);
+  if (!live)
+    return false;
+
+  // Fails with ENXIO if nobody is listening, then we handle it ourselves
+  fd = open(path, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0)
+    return false;
+
+  len = snprintf(line, sizeof(line), "%s\n", command);
+  if (write(fd, line, len) != len)
+    {
+      close(fd);
+      return false;
+    }
+  close(fd);
+
+  DPRINTF(E_INFO, L_PLAYER, "Live pipe: forwarded remote command '%s'\n", command);
+  return true;
+}
